# Keep the course persona switcher (default), or require account sign-in.
EDM_AUTH_MODE=demo
# Set true when serving over HTTPS. Leave false for localhost HTTP.
EDM_SECURE_COOKIES=false
# Required. For the shared classroom demonstration, use the shared PostgreSQL database.
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
# For a local PostgreSQL server without TLS, use 127.0.0.1 and sslmode=disable.
# The frontend origin permitted to send writes, without a trailing slash.
EDM_PUBLIC_ORIGIN=http://localhost:3005
# For hosting, set the canonical frontend HTTPS origin instead.
# Database tests require a separate, empty PostgreSQL database.
# EDM_TEST_DATABASE_URL=postgresql://USERNAME:PASSWORD@TEST_HOST/TEST_DATABASE?sslmode=require

# Student email verification: real delivery uses Resend and a verified sender.
EDM_EMAIL_MODE=resend
# RESEND_API_KEY=re_YOUR_KEY
# EDM_EMAIL_FROM=UniData 360 <accounts@YOUR_VERIFIED_DOMAIN>
# For a localhost classroom demonstration without a provider key, use:
# EDM_EMAIL_MODE=preview
# Verification messages are saved privately in backend/.local-email/.
# Preview delivery is rejected on cloud hosts or non-loopback frontend origins.
