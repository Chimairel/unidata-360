# Keep the course persona switcher (default), or require account sign-in.
EDM_AUTH_MODE=demo
# Set true when serving over HTTPS. Leave false for localhost HTTP.
EDM_SECURE_COOKIES=false
# Optional local SQLite path. Defaults to ./data/unidata.sqlite.
# EDM_DATABASE_PATH=./data/unidata.sqlite
# Optional Neon PostgreSQL URL. Leave unset for a fresh local SQLite demo.
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
# Exact canonical HTTPS origin, without a trailing slash.
# EDM_PUBLIC_ORIGIN=https://your-project.vercel.app
# PostgreSQL smoke tests require a separate, disposable branch.
# EDM_TEST_DATABASE_URL=postgresql://USERNAME:PASSWORD@TEST_HOST/TEST_DATABASE?sslmode=require
